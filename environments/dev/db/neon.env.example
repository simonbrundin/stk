# Kopiera den här filen till neon.env och fyll i riktiga värden.
# neon.env gitignoras och används av kustomize (secretGenerator) för att
# skapa Secreten repo-template-db-neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DB?sslmode=require
# Atlas använder direkt endpoint (channel_binding stöds inte av lib/pq).
uri=postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DB?sslmode=require
