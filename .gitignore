# Environment
.env
.env.*
!.env.example
!.env.template
environments/dev/.env
environments/pr/.env
environments/prod/.env

# DevSpace
.devspace/

# Lokalt kompilerade Go-binärer (CLI/TUI byggs lokalt, inte i Docker)
src/go/bin/

# Kustomize Helm chart caches generated by --enable-helm
environments/dev/charts/
environments/dev/pgadmin/charts/

# Dekrypterade MATCHi-credentials för dev (gitignoras - innehåller riktiga lösenord)
environments/dev/secrets/matchi.env

# Neon-credentials för dev (gitignoras - innehåller riktiga lösenord)
environments/dev/db/neon.env
environments/dev/pgadmin/pgadmin-values.yaml
